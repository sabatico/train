# Spell Quest — secrets template. Copy to .env (gitignored) and fill in real values.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Set to 1 to enable LIVE agent enrichment (kid-voice correction feedback).
# Off by default so dev/tests are deterministic and never spend. Turn on for
# real sessions with the child.
SPELLQUEST_AGENT_LIVE=0

# OpenAI — used ONLY to pre-generate natural dictation audio (ADR-013). Set the
# key, then run: .venv/bin/python scripts/generate_audio.py
# Until clips exist, the app falls back to the (robotic) browser voice.
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_TTS_VOICE=nova
